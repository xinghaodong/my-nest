# .env
PORT=3001
 
# 数据库配置
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=123456
DB_DATABASE=nestdatabase

# JWT
JWT_SECRET=secretKey
JWT_EXPIRES_IN=1h
REFRESH_SECRET=refSecretKey
REFRESH_EXPIRES_IN=24h

# 创建用户时的默认密码
DEFAULT_PASSWORD=888888

# 阿里云 ai apikey
ALIYUN_API_KEY=sk-4171c7e9e7d84131ae6dc86fd6ae03f1

# 智谱 AI (GLM-4)
ZHIPU_API_KEY=6c13192ca1df4e8d8f4ab2f5caa0011f.0xI3XkLDeFX6U4qA

# AI 模型提供方 (zhipu / aliyun / ollama)
MODEL_PROVIDER=zhipu
AI_ZP_DEFAULT_MODEL=glm-4-flash

# gemma3:4b
AI_BD_DEFAULT_MODEL=gemma3:4b

# 本地/内网穿透 Ollama 服务
OLLAMA_HOST=100.102.217.36

# Ollama 内存保活时间 (0=推理完立刻卸载模型释放内存；30s=30秒后释放；5m=默认5分钟)
AI_OLLAMA_KEEP_ALIVE=10s

# 限制 Ollama 上下文窗口大小 (控制集显共享显存与 KV 缓存大小，2048 足够审批使用)
AI_OLLAMA_NUM_CTX=2048

# 本地 PaddleOCR 智能识别服务 (支持 HTTP 端口服务与 Python CLI 降级两种模式)
OCR_SERVICE_URL=http://127.0.0.1:8100/ocr
OCR_PYTHON_PATH=D:\codeFile\xuexi\minimax\ocr-server\.venv\Scripts\python.exe
OCR_SCRIPT_PATH=D:\codeFile\xuexi\minimax\ocr-server\api_server.py